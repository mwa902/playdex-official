 with `␍⏎····id:·'winter-cup',␍⏎····name:·'Winter·Indoor·Cup',␍⏎····type:·'Tournament',␍⏎····venue:·'Central·Sports·Hall',␍⏎····date:·'2026-11-22',␍⏎····capacity:·48,␍⏎····status:·'Draft',␍⏎·`",{"range":"403","text":"404"},"Replace `·id:·'northside',·name:·'Northside·Tennis·Center',·city:·'Manchester',·courts:·8,·availability:·'Available'` with `␍⏎····id:·'northside',␍⏎····name:·'Northside·Tennis·Center',␍⏎····city:·'Manchester',␍⏎····courts:·8,␍⏎····availability:·'Available',␍⏎·`",{"range":"405","text":"406"},"Replace `·id:·'riverside',·name:·'Riverside·Courts',·city:·'Leeds',·courts:·6,·availability:·'Limited'` with `␍⏎····id:·'riverside',␍⏎····name:·'Riverside·Courts',␍⏎····city:·'Leeds',␍⏎····courts:·6,␍⏎····availability:·'Limited',␍⏎·`",{"range":"407","text":"408"},"Replace `·id:·'central',·name:·'Central·Sports·Hall',·city:·'Birmingham',·courts:·4,·availability:·'Available'` with `␍⏎····id:·'central',␍⏎····name:·'Central·Sports·Hall',␍⏎····city:·'Birmingham',␍⏎····courts:·4,␍⏎····availability:·'Available',␍⏎·`",{"range":"409","text":"410"},"Replace `·id:·'b-1',·participant:·'Maya·Patel',·event:·'Northside·Open',·created:·'2026-09-16',·status:·'Confirmed'` with `␍⏎····id:·'b-1',␍⏎····participant:·'Maya·Patel',␍⏎····event:·'Northside·Open',␍⏎····created:·'2026-09-16',␍⏎····status:·'Confirmed',␍⏎·`",{"range":"411","text":"412"},"Replace `·id:·'b-2',·participant:·'Oliver·Reed',·event:·'Riverside·Doubles·League',·created:·'2026-09-17',·status:·'Pending'` with `␍⏎····id:·'b-2',␍⏎····participant:·'Oliver·Reed',␍⏎····event:·'Riverside·Doubles·League',␍⏎····created:·'2026-09-17',␍⏎····status:·'Pending',␍⏎·`",{"range":"413","text":"414"},"Replace `·id:·'b-3',·participant:·'Sofia·Khan',·event:·'Northside·Open',·created:·'2026-09-18',·status:·'Waitlisted'` with `␍⏎····id:·'b-3',␍⏎····participant:·'Sofia·Khan',␍⏎····event:·'Northside·Open',␍⏎····created:·'2026-09-18',␍⏎····status:·'Waitlisted',␍⏎·`",{"range":"415","text":"416"},"Replace `·id:·'u-1',·name:·'Alex·Morgan',·email:·'alex@playdex.io'·` with `␍⏎··id:·'u-1',␍⏎··name:·'Alex·Morgan',␍⏎··email:·'alex@playdex.io',␍⏎`",{"range":"417","text":"418"},"Insert `␍⏎·`",{"range":"419","text":"420"},"@typescript-eslint/require-await","Async method 'logout' has no 'await' expression.","ArrowFunctionExpression","missingAwait",["421"],[91,122],"\r\n  return <CreateAccountPage />;\r\n",[86,112],"\r\n  return <BookingsPage />;\r\n",[84,108],"\r\n  return <EventsPage />;\r\n",[89,200],"\r\n  params,\r\n}: {\r\n  params: Promise<{ id: string }>;\r\n}) {\r\n  const { id } = await params;\r\n  return <EventDetail id={id} />;\r\n",[153,230],"\r\n  title: 'Playdex Operations',\r\n  description: 'Sports event operations console',\r\n",[272,282],"\r\n  children,\r\n",[338,405],"(\r\n    <html lang=\"en\">\r\n      <body>\r\n        <AppShell>{children}</AppShell>\r\n      </body>\r\n    </html>\r\n  )",[83,106],"\r\n  return <Dashboard />;\r\n",[84,108],"\r\n  return <VenuesPage />;\r\n",[102,215],"\r\n  Avatar,\r\n  Button,\r\n  FluentProvider,\r\n  Tab,\r\n  TabList,\r\n  Toolbar,\r\n  ToolbarButton,\r\n  tokens,\r\n  createLightTheme,\r\n  createDarkTheme,\r\n",[261,356],"\r\n  CalendarRegular,\r\n  DataBarVerticalRegular,\r\n  HomeRegular,\r\n  WeatherSunnyRegular,\r\n  WeatherMoonRegular,\r\n",[410,657],"\r\n  10: '#001f2b',\r\n  20: '#003747',\r\n  30: '#004d62',\r\n  40: '#07617a',\r\n  50: '#0f5b78',\r\n  60: '#28728b',\r\n  70: '#47899e',\r\n  80: '#6ba1b2',\r\n  90: '#8fb8c5',\r\n  100: '#afd0d9',\r\n  110: '#c8e1e7',\r\n  120: '#d9ebef',\r\n  130: '#e7f2f4',\r\n  140: '#eff7f8',\r\n  150: '#f6fbfc',\r\n  160: '#ffffff',\r\n",[698,708],[818,873],"\r\n    setDark(localStorage.getItem('app-theme') === 'dark');\r\n ",[912,1007],"\r\n    const next = !dark;\r\n    setDark(next);\r\n    localStorage.setItem('app-theme', next ? 'dark' : 'light');\r\n ",[1103,1103],"(\r\n    ",[1157,1276],"  <header\r\n        style={{\r\n          borderBottom: `1px solid ${tokens.colorNeutralStroke2}`,\r\n          background: tokens.colorNeutralBackground1,\r\n        }}\r\n      ",[1279,1393],"        <Toolbar\r\n          style={{\r\n            maxWidth: 1440,\r\n            margin: '0 auto',\r\n            padding: '12px 36px',\r\n            justifyContent: 'space-between',\r\n          }}\r\n        ",[1396,1587],"          <Link\r\n            href=\"/\"\r\n            style={{\r\n              display: 'inline-flex',\r\n              alignItems: 'center',\r\n              gap: 8,\r\n              color: 'inherit',\r\n              textDecoration: 'none',\r\n              fontWeight: 600,\r\n            }}\r\n          >\r\n            <DataBarVerticalRegular />\r\n            Playdex Operations\r\n          ",[1596,1735],"          <ToolbarButton\r\n            icon={dark ? <WeatherSunnyRegular /> : <WeatherMoonRegular />}\r\n            aria-label=\"Toggle color theme\"\r\n            onClick={toggleTheme}\r\n         ",[1740,1740],"  ",[1799,1799],[1817,1909],"  <TabList\r\n          appearance=\"subtle\"\r\n          style={{ maxWidth: 1440, margin: '0 auto', padding: '0 36px' }}\r\n        ",[1912,2023],"          <Tab\r\n            icon={<HomeRegular />}\r\n            value=\"dashboard\"\r\n            onClick={() => {\r\n              window.location.href = '/';\r\n            }}\r\n          >\r\n            Dashboard\r\n          ",[2039,2146],"  <Tab\r\n            icon={<CalendarRegular />}\r\n            value=\"events\"\r\n            onClick={() => {\r\n              window.location.href = '/events';\r\n            }}\r\n          >\r\n            Events\r\n          ",[2162,2276],"  <Tab\r\n            icon={<DataBarVerticalRegular />}\r\n            value=\"venues\"\r\n            onClick={() => {\r\n              window.location.href = '/venues';\r\n            }}\r\n          >\r\n            Venues\r\n          ",[2292,2405],"  <Tab\r\n            icon={<CalendarRegular />}\r\n            value=\"bookings\"\r\n            onClick={() => {\r\n              window.location.href = '/bookings';\r\n            }}\r\n          >\r\n            Bookings\r\n          ",[2413,2413],[2435,2435],[2446,2446],[2498,2515],"  </FluentProvider>\r\n  )",[2552,2687],"\r\n  state,\r\n  onChange,\r\n}: {\r\n  state: 'loading' | 'error' | 'empty' | 'data';\r\n  onChange: (state: 'loading' | 'error' | 'empty' | 'data') => void;\r\n",[2702,3081],"(\r\n    <div\r\n      style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginBottom: 14 }}\r\n    >\r\n      <span style={{ color: tokens.colorNeutralForeground3, fontSize: 12 }}>\r\n        Preview state:\r\n      </span>\r\n      {(['data', 'loading', 'empty', 'error'] as const).map((option) => (\r\n        <Button\r\n          key={option}\r\n          size=\"small\"\r\n          appearance={state === option ? 'primary' : 'subtle'}\r\n          onClick={() => onChange(option)}\r\n        >\r\n          {option}\r\n        </Button>\r\n      ))}\r\n    </div>\r\n  )",[102,268],"\r\n  Button,\r\n  Card,\r\n  CardHeader,\r\n  MessageBar,\r\n  Skeleton,\r\n  Table,\r\n  TableBody,\r\n  TableCell,\r\n  TableHeader,\r\n  TableHeaderCell,\r\n  TableRow,\r\n  Title1,\r\n  Title2,\r\n  Title3,\r\n  Body1,\r\n  Caption1,\r\n  tokens,\r\n",[314,442],"\r\n  AddRegular,\r\n  ArrowRightRegular,\r\n  CalendarRegular,\r\n  CheckmarkCircleRegular,\r\n  ErrorCircleRegular,\r\n  LocationRegular,\r\n  PeopleTeamRegular,\r\n",[522,574],"\r\n  BookingRecord,\r\n  DataState,\r\n  EventRecord,\r\n  VenueRecord,\r\n",{"messageId":"422","data":"423","fix":"424","desc":"425"},{"messageId":"422","data":"426","fix":"427","desc":"428"},{"messageId":"422","data":"429","fix":"430","desc":"431"},[663,793],"\r\n  title,\r\n  eyebrow,\r\n  description,\r\n  action,\r\n  href,\r\n}: {\r\n  title: string;\r\n  eyebrow: string;\r\n  description: string;\r\n  action: string;\r\n  href: string;\r\n",[808,1593],"(\r\n    <section className=\"hero\">\r\n      <svg\r\n        className=\"hero-mesh\"\r\n        aria-hidden=\"true\"\r\n        viewBox=\"0 0 800 400\"\r\n        preserveAspectRatio=\"none\"\r\n      >\r\n        <defs>\r\n          <radialGradient id=\"m1\">\r\n            <stop offset=\"0\" stopColor=\"#fbbf24\" stopOpacity=\".55\" />\r\n            <stop offset=\"1\" stopColor=\"#fbbf24\" stopOpacity=\"0\" />\r\n          </radialGradient>\r\n          <radialGradient id=\"m2\">\r\n            <stop offset=\"0\" stopColor=\"#0f5b78\" stopOpacity=\".6\" />\r\n            <stop offset=\"1\" stopColor=\"#0f5b78\" stopOpacity=\"0\" />\r\n          </radialGradient>\r\n        </defs>\r\n        <rect width=\"800\" height=\"400\" fill=\"url(#m1)\" />\r\n        <rect width=\"800\" height=\"400\" fill=\"url(#m2)\" />\r\n      </svg>\r\n      <div className=\"hero-content\">\r\n        <p className=\"eyebrow\">{eyebrow}</p>\r\n        <h1>{title}</h1>\r\n        <p>{description}</p>\r\n        <Button\r\n          onClick={() => {\r\n            window.location.href = href;\r\n          }}\r\n          appearance=\"primary\"\r\n          icon={<ArrowRightRegular />}\r\n        >\r\n          {action}\r\n        </Button>\r\n      </div>\r\n    </section>\r\n  )",[1646,1891],"\r\n  const tone =\r\n    value === 'Published' || value === 'Confirmed' || value === 'Available'\r\n      ? 'success'\r\n      : value === 'Draft' || value === 'Pending' || value === 'Limited'\r\n        ? 'warning'\r\n        : '';\r\n  return <span className={`status-pill ${tone}`}>{value}</span>;\r\n",[1914,2727],"\r\n  state,\r\n  retry,\r\n  children,\r\n}: {\r\n  state: DataState;\r\n  retry: () => void;\r\n  children: React.ReactNode;\r\n}) {\r\n  if (state === 'loading')\r\n    return (\r\n      <Card>\r\n        <Skeleton animation=\"wave\" style={{ height: 20, margin: 12 }} />\r\n        <Skeleton animation=\"wave\" style={{ height: 20, margin: 12 }} />\r\n        <Skeleton animation=\"wave\" style={{ height: 20, margin: 12 }} />\r\n      </Card>\r\n    );\r\n  if (state === 'error')\r\n    return (\r\n      <MessageBar intent=\"error\" icon={<ErrorCircleRegular />}>\r\n        Unable to load operational data.{' '}\r\n        <Button appearance=\"transparent\" onClick={retry}>\r\n          Retry loading\r\n        </Button>\r\n      </MessageBar>\r\n    );\r\n  if (state === 'empty')\r\n    return (\r\n      <Card style={{ padding: 36, textAlign: 'center' }}>\r\n        <span style={{ fontSize: 52 }}>\r\n          <PeopleTeamRegular />\r\n        </span>\r\n        <Title3>No records in this view</Title3>\r\n        <Body1>Once activity arrives, it will appear here.</Body1>\r\n      </Card>\r\n    );\r\n  return <>{children}</>;\r\n",[2777,3094],"\r\n  const [state, setState] = useState<DataState>('loading');\r\n  const [data, setData] = useState<T | null>(null);\r\n  const load = () => {\r\n    setState('loading');\r\n    loader()\r\n      .then((value) => {\r\n        setData(value);\r\n        setState('data');\r\n      })\r\n      .catch(() => setState('error'));\r\n  };\r\n  useEffect(load, [loader]);\r\n  return { state, data, load, setState };\r\n",[3128,6349],"\r\n  const events = useData(api.listEvents);\r\n  const bookings = useData(api.listBookings);\r\n  const venues = useData(api.listVenues);\r\n  return (\r\n    <div className=\"page-grid\">\r\n      <Hero\r\n        eyebrow=\"Operations dashboard\"\r\n        title=\"Keep every match moving.\"\r\n        description=\"A focused command center for event readiness, venue capacity, and participant flow across the Playdex network.\"\r\n        action=\"Review events\"\r\n        href=\"/events\"\r\n      />\r\n      <div className=\"metric-grid\">\r\n        <Card>\r\n          <CardHeader\r\n            image={<CalendarRegular />}\r\n            header={<Caption1>Upcoming events</Caption1>}\r\n          />\r\n          <Title2>12</Title2>\r\n          <Caption1>+3 this month</Caption1>\r\n        </Card>\r\n        <Card>\r\n          <CardHeader\r\n            image={<PeopleTeamRegular />}\r\n            header={<Caption1>Active bookings</Caption1>}\r\n          />\r\n          <Title2>148</Title2>\r\n          <Caption1>91% confirmed</Caption1>\r\n        </Card>\r\n        <Card>\r\n          <CardHeader\r\n            image={<LocationRegular />}\r\n            header={<Caption1>Venue readiness</Caption1>}\r\n          />\r\n          <Title2>8 / 11</Title2>\r\n          <Caption1>ready to host</Caption1>\r\n        </Card>\r\n        <Card>\r\n          <CardHeader\r\n            image={<CheckmarkCircleRegular />}\r\n            header={<Caption1>Service status</Caption1>}\r\n          />\r\n          <Title2 style={{ color: tokens.colorPaletteGreenForeground1 }}>\r\n            Healthy\r\n          </Title2>\r\n          <Caption1>All systems operational</Caption1>\r\n        </Card>\r\n      </div>\r\n      <div className=\"data-grid\">\r\n        <Card>\r\n          <CardHeader\r\n            header={<Title3>Next on the schedule</Title3>}\r\n            action={\r\n              <Button\r\n                onClick={() => {\r\n                  window.location.href = '/events';\r\n                }}\r\n                appearance=\"subtle\"\r\n                icon={<ArrowRightRegular />}\r\n              >\r\n                View all\r\n              </Button>\r\n            }\r\n          />\r\n          <StateToggle state={events.state} onChange={events.setState} />\r\n          <StateView state={events.state} retry={events.load}>\r\n            <Table>\r\n              <TableHeader>\r\n                <TableRow>\r\n                  <TableHeaderCell>Event</TableHeaderCell>\r\n                  <TableHeaderCell>Venue</TableHeaderCell>\r\n                  <TableHeaderCell>Date</TableHeaderCell>\r\n                  <TableHeaderCell>Status</TableHeaderCell>\r\n                </TableRow>\r\n              </TableHeader>\r\n              <TableBody>\r\n                {events.data?.map((event) => (\r\n                  <TableRow key={event.id}>\r\n                    <TableCell>\r\n                      <Link href={`/events/${event.id}`}>{event.name}</Link>\r\n                    </TableCell>\r\n                    <TableCell>{event.venue}</TableCell>\r\n                    <TableCell>{event.date}</TableCell>\r\n                    <TableCell>\r\n                      <Status value={event.status} />\r\n                    </TableCell>\r\n                  </TableRow>\r\n                ))}\r\n              </TableBody>\r\n            </Table>\r\n          </StateView>\r\n        </Card>\r\n        <Card>\r\n          <CardHeader\r\n            header={<Title3>Recent bookings</Title3>}\r\n            action={\r\n              <Button\r\n                onClick={() => {\r\n                  window.location.href = '/bookings';\r\n                }}\r\n                appearance=\"subtle\"\r\n              >\r\n                Open queue\r\n              </Button>\r\n            }\r\n          />\r\n          <StateToggle state={bookings.state} onChange={bookings.setState} />\r\n          <StateView state={bookings.state} retry={bookings.load}>\r\n            <div style={{ display: 'grid', gap: 14 }}>\r\n              {bookings.data?.map((booking) => (\r\n                <div\r\n                  key={booking.id}\r\n                  style={{\r\n                    display: 'flex',\r\n                    justifyContent: 'space-between',\r\n                    gap: 12,\r\n                  }}\r\n                >\r\n                  <div>\r\n                    <Body1>{booking.participant}</Body1>\r\n                    <Caption1>{booking.event}</Caption1>\r\n                  </div>\r\n                  <Status value={booking.status} />\r\n                </div>\r\n              ))}\r\n            </div>\r\n          </StateView>\r\n        </Card>\r\n      </div>\r\n      <Card>\r\n        <CardHeader\r\n          header={<Title3>Venue pulse</Title3>}\r\n          action={\r\n            <Button\r\n             